# Copy to .env for local development. Set the same variables in Vercel
# (Project > Settings > Environment Variables). Never commit real values.

# Public production URL, used for canonical links, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://www.your-domain.com

# Consultation form email delivery via Resend (https://resend.com).
# Until all three are set, the form shows an honest "not switched on yet"
# message and nothing is sent or stored.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that receives consultation requests.
CONTACT_TO_EMAIL=you@your-domain.com
# Sender on a domain verified in Resend, e.g. "Pearl River Marketing <forms@your-domain.com>"
CONTACT_FROM_EMAIL=Pearl River Marketing <forms@your-domain.com>
