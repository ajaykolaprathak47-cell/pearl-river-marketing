# Copy to .env for local development. Set the same variables in Vercel
# (Project > Settings > Environment Variables). Placeholder values only.
# Never commit real keys: .env is already in .gitignore.

# ── Production domain ───────────────────────────────────────────────
# Used for canonical links, Open Graph URLs, robots.txt and the sitemap.
# This is the ONLY place the domain is set. Include https://, no trailing slash.
PUBLIC_SITE_URL=https://www.your-domain.com

# ── Consultation form (Resend) ─────────────────────────────────────
# Required. Create at https://resend.com/api-keys ("Sending access" is enough).
RESEND_API_KEY=re_your_api_key_here

# Required. The inbox that receives consultation requests.
CONTACT_TO_EMAIL=you@example.com

# Recommended. A sender on a domain you have verified in Resend.
# If left empty, the site uses Resend's test sender (onboarding@resend.dev),
# which ONLY delivers to the email address that owns your Resend account.
# That's fine for testing before your domain is set up, but set this before launch.
CONTACT_FROM_EMAIL=Pearl River Marketing <forms@your-domain.com>
