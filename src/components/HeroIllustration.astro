---
/**
 * Illustration used in the home hero: a search ad leading to an inquiry.
 * Every name in it is generic. It is labeled as an illustration, not client work.
 */
---
<figure class="illus" aria-label="Illustration: a local search ad that leads to a new customer inquiry">
  <div class="search">
    <div class="query">
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <span>ac repair picayune ms</span>
    </div>
    <div class="ad">
      <p class="sponsored">Sponsored · yourbusiness.com</p>
      <p class="headline">Same-Week AC Repair in Picayune</p>
      <p class="body">Local, licensed technicians. Call now or request a visit online.</p>
      <div class="ext"><span>Request a Visit</span><span>Call Now</span></div>
    </div>
  </div>

  <div class="flow" aria-hidden="true">
    <span></span>
  </div>

  <div class="lead">
    <p class="lead-title"><span class="dot"></span>New inquiry</p>
    <dl>
      <div><dt>Source</dt><dd>Google Search</dd></div>
      <div><dt>Service</dt><dd>AC repair</dd></div>
      <div><dt>Form</dt><dd>Request a Visit</dd></div>
    </dl>
  </div>
  <figcaption>Illustration, not a client result</figcaption>
</figure>

<style>
  .illus { margin: 0; display: grid; gap: 0; justify-items: stretch; max-width: 27rem; width: 100%; justify-self: end; }
  .search, .lead {
    background: var(--white); color: var(--ink); border-radius: 10px;
    box-shadow: 0 20px 50px rgb(3 10 20 / 35%);
  }
  .search { padding: 1rem; display: grid; gap: .85rem; }
  .query {
    display: flex; align-items: center; gap: .6rem; border: 1px solid var(--line); border-radius: 999px;
    padding: .55rem 1rem; font-size: .92rem; color: var(--ink-soft);
  }
  .query svg { width: 1rem; height: 1rem; color: var(--ink-soft); flex: none; }
  .ad { display: grid; gap: .2rem; padding: .25rem .25rem .1rem; }
  .sponsored { font-size: .75rem; color: var(--ink-soft); }
  .headline { font-size: 1.12rem; color: #1a4fb5; font-weight: 500; }
  .body { font-size: .88rem; color: var(--ink-soft); }
  .ext { display: flex; gap: .5rem; margin-top: .5rem; flex-wrap: wrap; }
  .ext span { font-size: .78rem; border: 1px solid var(--line); border-radius: 999px; padding: .2rem .7rem; color: #1a4fb5; }
  .flow { height: 3.25rem; display: flex; justify-content: center; }
  .flow span { width: 2px; height: 100%; background: linear-gradient(var(--gold-500), rgb(201 162 74 / 20%)); position: relative; }
  .flow span::after {
    content: ''; position: absolute; left: 50%; bottom: -2px; width: .6rem; height: .6rem; transform: translateX(-50%) rotate(45deg);
    border-right: 2px solid var(--gold-500); border-bottom: 2px solid var(--gold-500);
  }
  .lead { padding: 1rem 1.25rem; width: 82%; justify-self: center; }
  .lead-title { font-weight: 650; display: flex; align-items: center; gap: .5rem; font-size: .95rem; }
  .dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 4px var(--ok-bg); }
  dl { margin: .75rem 0 0; display: grid; gap: .35rem; }
  dl div { display: flex; justify-content: space-between; gap: 1rem; font-size: .85rem; border-top: 1px solid var(--line); padding-top: .35rem; }
  dt { color: var(--ink-soft); }
  dd { margin: 0; font-weight: 550; }
  figcaption { margin-top: 1rem; text-align: center; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: #93a2b6; }
  @media (max-width: 900px) { .illus { justify-self: center; } }
</style>
