---
/**
 * Illustration used in the home hero: a sponsored social post and a content calendar.
 * Every name in it is generic. It is labeled as an illustration, not client work.
 */
const week = [
  { d: 'Mon', t: 'Tip', on: true },
  { d: 'Tue', t: '', on: false },
  { d: 'Wed', t: 'Offer', on: true },
  { d: 'Thu', t: '', on: false },
  { d: 'Fri', t: 'Job photo', on: true },
];
---
<figure class="illus" aria-label="Illustration: a sponsored Facebook post and a weekly posting schedule">
  <div class="post">
    <div class="post-head">
      <span class="avatar" aria-hidden="true">YB</span>
      <div>
        <p class="biz">Your Business</p>
        <p class="meta">Sponsored</p>
      </div>
    </div>
    <p class="copy">Summer AC tune-ups are booking now in Picayune. Send us a message to get on the schedule.</p>
    <div class="photo" aria-hidden="true">
      <svg viewBox="0 0 320 150" preserveAspectRatio="xMidYMid slice">
        <rect width="320" height="150" fill="#1a3252"/>
        <circle cx="250" cy="42" r="22" fill="#c9a24a"/>
        <path d="M0 115 Q80 80 160 110 T320 100 V150 H0Z" fill="#274a3a"/>
        <rect x="60" y="62" width="70" height="52" rx="3" fill="#e6ebf2"/>
        <path d="M52 66 L95 38 L138 66Z" fill="#c9a24a"/>
        <rect x="84" y="86" width="20" height="28" fill="#10223a"/>
      </svg>
    </div>
    <div class="cta-row">
      <span>yourbusiness · Picayune, MS</span>
      <span class="send">Send message</span>
    </div>
  </div>

  <div class="calendar">
    <p class="cal-title">This week's posts</p>
    <ul>
      {week.map((w) => (
        <li class:list={{ on: w.on }}>
          <span class="day">{w.d}</span>
          <span class="dot" aria-hidden="true"></span>
          <span class="type">{w.t || '—'}</span>
        </li>
      ))}
    </ul>
  </div>
  <figcaption>Illustration, not a client result</figcaption>
</figure>

<style>
  .illus { margin: 0; display: grid; max-width: 25rem; width: 100%; justify-self: end; position: relative; }
  .post, .calendar { background: var(--white); color: var(--ink); border-radius: 10px; box-shadow: 0 20px 50px rgb(3 10 20 / 35%); }
  .post { padding: 1rem 1rem .9rem; display: grid; gap: .75rem; }
  .post-head { display: flex; align-items: center; gap: .65rem; }
  .avatar { width: 2.3rem; height: 2.3rem; border-radius: 50%; background: var(--navy-800); color: var(--gold-500); display: grid; place-items: center; font-size: .78rem; font-weight: 700; flex: none; }
  .biz { font-weight: 650; font-size: .95rem; line-height: 1.2; }
  .meta { font-size: .75rem; color: var(--ink-soft); }
  .copy { font-size: .9rem; line-height: 1.45; }
  .photo { border-radius: 6px; overflow: hidden; aspect-ratio: 32 / 15; max-width: 100%; }
  .photo svg { width: 100%; height: 100%; }
  .cta-row { display: flex; justify-content: space-between; align-items: center; gap: .75rem; font-size: .78rem; color: var(--ink-soft); }
  .send { background: var(--navy-100); color: var(--navy-800); font-weight: 650; padding: .35rem .75rem; border-radius: 5px; white-space: nowrap; }
  .calendar { padding: .9rem 1.1rem 1rem; width: 86%; justify-self: center; margin-top: -1rem; position: relative; }
  .cal-title { font-weight: 650; font-size: .88rem; margin-bottom: .6rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .35rem; }
  li { display: grid; justify-items: center; gap: .3rem; font-size: .7rem; color: var(--ink-soft); padding: .45rem .1rem; border-radius: 6px; background: var(--paper); }
  li.on { background: var(--gold-100); color: var(--ink); }
  .day { font-weight: 650; }
  .dot { width: .45rem; height: .45rem; border-radius: 50%; background: var(--line); }
  li.on .dot { background: var(--gold-600); }
  .type { white-space: nowrap; }
  figcaption { margin-top: 1rem; text-align: center; font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: #93a2b6; }
  @media (max-width: 900px) { .illus { justify-self: center; } }
</style>
