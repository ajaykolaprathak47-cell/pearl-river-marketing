---
import Logo from './Logo.astro';
import { nav, site, cta } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="home" aria-label={`${site.name}, home`}><Logo height={48} eager /></a>

    <nav class="primary" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="btn btn-primary cta" href="/contact" data-track="cta_header">{cta.primary}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="visually-hidden">Open menu</span>
        <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Mobile">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn btn-primary" href="/contact" data-track="cta_mobile_menu">{cta.primary}</a>
      <a class="mobile-phone" href={`tel:${site.phone.e164}`} data-track="phone_click">Call or text {site.phone.display}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgb(245 241 232 / 88%);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid rgb(7 40 63 / 8%);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 4.75rem; }
  .home { display: block; flex: none; width: min(259px, 60vw); }
  .primary ul { display: flex; gap: .25rem; list-style: none; margin: 0; padding: 0; }
  .primary a {
    display: block; padding: .5rem .9rem; border-radius: 999px;
    text-decoration: none; color: var(--ink-soft); font-weight: 600; font-size: .95rem;
    transition: color .2s var(--ease), background-color .2s var(--ease);
  }
  .primary a:hover { color: var(--navy-800); background: var(--mist); }
  .primary a[aria-current='page'] { color: var(--navy-800); background: var(--mist); }
  .actions { display: flex; align-items: center; gap: .75rem; }
  .cta { min-height: 2.75rem; padding: .6rem 1.2rem; font-size: .93rem; white-space: nowrap; }

  .menu-toggle {
    display: none; width: 2.9rem; height: 2.9rem; border: 1px solid var(--line); border-radius: 999px;
    background: var(--white); cursor: pointer; align-items: center; justify-content: center; flex: none;
  }
  .bars, .bars::before, .bars::after {
    display: block; width: 1.1rem; height: 2px; background: var(--navy-800); border-radius: 2px;
    transition: transform .2s var(--ease), background-color .2s;
  }
  .bars { position: relative; }
  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
  .bars::before { top: -6px; }
  .bars::after { top: 6px; }
  .menu-toggle[aria-expanded='true'] .bars { background: transparent; }
  .menu-toggle[aria-expanded='true'] .bars::before { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .bars::after { transform: translateY(-6px) rotate(-45deg); }

  .mobile-menu { border-top: 1px solid var(--line); background: var(--white); box-shadow: 0 24px 40px -24px rgb(7 40 63 / 35%); }
  .mobile-menu nav { padding-block: .75rem 1.5rem; display: grid; gap: 1rem; }
  .mobile-menu ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .mobile-menu li a {
    display: block; padding: .95rem .25rem; border-bottom: 1px solid var(--line);
    font-size: 1.15rem; font-weight: 650; color: var(--navy-800); text-decoration: none; letter-spacing: -.01em;
  }
  .mobile-menu li a[aria-current='page'] { color: var(--gold-700); }
  .mobile-menu .btn { width: 100%; margin-top: .5rem; }
  .mobile-phone { text-align: center; font-weight: 600; text-decoration: none; color: var(--navy-700); }

  @media (max-width: 900px) {
    .primary, .cta { display: none; }
    .menu-toggle { display: inline-flex; }
    .bar { min-height: 4.25rem; }
  }
  @media (min-width: 901px) { .mobile-menu { display: none !important; } }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const label = toggle.querySelector('.visually-hidden');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); }
    });
  }
</script>

<script>
  import { initTracking } from '../lib/analytics';
  initTracking();
</script>
