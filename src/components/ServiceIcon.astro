---
interface Props { name: 'advertising' | 'social-media' | 'websites' | string }
const { name } = Astro.props;
---
<span class="icon" aria-hidden="true">
  {name === 'advertising' ? (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 13v6a2 2 0 0 0 2 2h2l5 5V7l-5 5H7a2 2 0 0 0-2 1Z"/>
      <path d="M14 7c5 1 9 4.5 9 9s-4 8-9 9"/>
      <path d="M26 11.5c1.3 1.3 2 2.8 2 4.5s-.7 3.2-2 4.5" class="g"/>
    </svg>
  ) : name === 'websites' ? (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="6" width="24" height="20" rx="3.5"/>
      <path d="M4 11.5h24"/>
      <path d="M8 8.8h.01M11 8.8h.01" stroke-width="2.4"/>
      <rect x="8.5" y="15" width="8" height="7" rx="1.2" class="g"/>
      <path d="M20 16h4M20 20h3"/>
    </svg>
  ) : (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="5" y="6" width="22" height="21" rx="4"/>
      <path d="M5 12h22M11 4v4M21 4v4"/>
      <rect x="10" y="16" width="5" height="6" rx="1.2" class="g"/>
      <path d="M19 17h4M19 21h3"/>
    </svg>
  )}
</span>

<style>
  .icon {
    width: 3.25rem; height: 3.25rem; border-radius: 14px; display: grid; place-items: center; flex: none;
    background: linear-gradient(145deg, var(--navy-100), #f4efe4); color: var(--navy-800);
  }
  svg { width: 1.8rem; height: 1.8rem; }
  .g { stroke: var(--gold-600); }
</style>
