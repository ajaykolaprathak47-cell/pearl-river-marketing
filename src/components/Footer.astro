---
import Logo from './Logo.astro';
import { nav, site, realEstateLink } from '../data/site';
const year = new Date().getFullYear();
const links = [...nav.filter((n) => n.href !== '/'), realEstateLink];
---
<footer class="site-footer">
  <div class="container top">
    <div class="brand">
      <a href="/" aria-label={`${site.name}, home`} class="logo-link"><Logo height={40} /></a>
      <p class="tag accent">{site.tagline}</p>
    </div>

    <nav aria-label="Footer">
      <ul class="links">
        {links.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="contact">
      <a class="phone" href={`tel:${site.phone.e164}`} data-track="phone_click">{site.phone.display}</a>
      {site.email && <a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a>}
      <span>{site.city}, {site.regionName}</span>
    </div>
  </div>

  <div class="container bottom">
    <p>© {year} {site.name} · Serving Pearl River County and South Mississippi</p>
    <ul>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/terms">Terms</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-800); color: #b9c6d6; }
  .top {
    display: grid; grid-template-columns: auto 1fr auto; gap: 2rem 3rem; align-items: center;
    padding-block: clamp(2.5rem, 6vw, 3.5rem);
  }
  .brand { display: grid; gap: .6rem; }
  /* The logo's wordmark is navy, so it sits on an ivory plate rather than being recolored. */
  .logo-link { display: block; width: 248px; max-width: 100%; padding: .8rem 1rem; border-radius: 14px; background: var(--bg); }
  .tag { color: var(--gold-500); font-size: 1.05rem; }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem 1.75rem; justify-content: center; }
  .links a, .contact a { color: var(--bg); text-decoration: none; font-weight: 600; font-size: .95rem; }
  .links a:hover, .contact a:hover { color: var(--gold-500); }
  .contact { display: grid; gap: .2rem; justify-items: end; font-size: .92rem; color: #b9c6d6; }
  .contact .phone { font-size: 1.05rem; color: var(--bg); font-variant-numeric: tabular-nums; }
  .bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem 1.5rem;
    border-top: 1px solid rgb(245 241 232 / 14%); padding-block: 1.25rem; font-size: .85rem; color: #a9b8c9;
  }
  .bottom ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.25rem; }
  .bottom a { color: #b9c6d6; text-decoration: none; }
  .bottom a:hover { color: var(--bg); text-decoration: underline; }
  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr; justify-items: start; }
    .links { justify-content: flex-start; }
    .contact { justify-items: start; }
  }
</style>
