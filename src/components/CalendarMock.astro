---
/** Visual for Social Media Content: a month content calendar with scheduled posts. Illustration only. */
const labels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
// Four weeks, weekdays only. Each cell: post type or empty.
const weeks: (null | { t: string; c: string })[][] = [
  [{ t: 'Offer', c: 'navy' }, null, { t: 'Tip', c: 'gold' }, null, { t: 'Project', c: 'river' }],
  [null, { t: 'Team', c: 'hill' }, null, { t: 'Offer', c: 'navy' }, null],
  [{ t: 'Review', c: 'gold' }, null, { t: 'Project', c: 'river' }, null, { t: 'Event', c: 'navy' }],
  [null, { t: 'Tip', c: 'gold' }, null, { t: 'Project', c: 'river' }, null],
];
---
<figure class="cal" aria-label="Illustration: a monthly content calendar with posts scheduled on Facebook and Instagram">
  <div class="panel">
    <div class="top">
      <p><b>Content calendar</b><small>This month</small></p>
      <span class="chip"><span class="dot" aria-hidden="true"></span>Approved</span>
    </div>
    <div class="grid" aria-hidden="true">
      {labels.map((l) => <span class="lbl">{l}</span>)}
      {weeks.flat().map((cell) => (
        <span class:list={['cell', cell && `on ${cell.c}`]}>{cell && <em>{cell.t}</em>}</span>
      ))}
    </div>
  </div>
  <div class="post" aria-hidden="true">
    <div class="thumb"><span>Weekend<br/>special</span></div>
    <div class="meta"><b>Fri · 9:00 AM</b><small>Facebook + Instagram</small></div>
  </div>
  <figcaption class="visually-hidden">Illustration, not a client calendar.</figcaption>
</figure>

<style>
  .cal { position: relative; margin: 0; max-width: 30rem; width: 100%; justify-self: center; padding-bottom: 2.5rem; }
  .panel { background: var(--white); border-radius: 18px; box-shadow: var(--shadow-lg); border: 1px solid rgb(7 40 63 / 6%); padding: 1.1rem; width: 92%; margin-left: auto; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: .9rem; }
  .top b { display: block; font-size: .95rem; color: var(--navy-800); }
  .top small { display: block; font-size: .75rem; color: var(--ink-faint); }
  .chip { display: inline-flex; align-items: center; gap: .4rem; font-size: .72rem; font-weight: 700; color: var(--ok); background: var(--ok-bg); padding: .3rem .6rem; border-radius: 99px; }
  .dot { width: .45rem; height: .45rem; border-radius: 50%; background: currentColor; }
  .grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .35rem; }
  .lbl { font-size: .65rem; font-weight: 700; color: var(--ink-faint); text-transform: uppercase; letter-spacing: .06em; padding-bottom: .15rem; }
  .cell { aspect-ratio: 1 / .82; border-radius: 8px; background: var(--canvas); display: flex; align-items: flex-end; padding: .3rem; min-width: 0; }
  .cell em { font-style: normal; font-size: .62rem; font-weight: 700; color: var(--white); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .on.navy { background: var(--navy-800); }
  .on.gold { background: var(--gold-700); }
  .on.river { background: var(--river); }
  .on.hill { background: var(--hill); }
  .post {
    position: absolute; left: 0; bottom: 0; display: flex; align-items: center; gap: .75rem;
    background: var(--white); border-radius: 14px; padding: .6rem .9rem .6rem .6rem; box-shadow: var(--shadow); border: 1px solid rgb(7 40 63 / 6%);
  }
  .thumb { width: 3.4rem; height: 3.4rem; border-radius: 10px; background: linear-gradient(150deg, var(--navy-700), var(--navy-900)); display: grid; place-items: center; flex: none; }
  .thumb span { color: var(--gold-500); font-size: .55rem; font-weight: 800; line-height: 1.1; text-align: center; text-transform: uppercase; letter-spacing: .04em; }
  .meta b { display: block; font-size: .82rem; color: var(--navy-800); }
  .meta small { display: block; font-size: .72rem; color: var(--ink-soft); }
  @media (max-width: 480px) { .panel { width: 100%; } }
</style>
