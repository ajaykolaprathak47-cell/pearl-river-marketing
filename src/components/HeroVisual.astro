---
/**
 * Hero composition: a phone showing an Instagram-style post, with a sponsored-ad chip
 * and a content-calendar card. Everything is generic and labeled as an illustration.
 */
const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const posted = [0, 2, 4];
---
<figure class="hv" aria-label="Illustration: a social media post on a phone, a live ad and a weekly posting schedule">
  <div class="glow" aria-hidden="true"></div>

  <div class="phone">
    <div class="screen">
      <div class="ig-top">
        <span class="av">YB</span>
        <span class="who"><b>yourbusiness</b><small>Picayune, Mississippi</small></span>
        <span class="dots" aria-hidden="true">•••</span>
      </div>
      <div class="art" aria-hidden="true">
        <svg viewBox="0 0 300 300" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id="hvSky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0b2f4a"/><stop offset=".65" stop-color="#22516e"/><stop offset="1" stop-color="#3f7390"/>
            </linearGradient>
          </defs>
          <rect width="300" height="300" fill="url(#hvSky)"/>
          <circle cx="210" cy="112" r="46" fill="none" stroke="#cba362" stroke-width="5"/>
          <path d="M0 178 Q70 150 140 172 T300 166 V300 H0Z" fill="#526252" opacity=".85"/>
          <path d="M40 300 C80 250 160 270 170 225 S250 190 300 196" stroke="#f7f6f2" stroke-width="14" fill="none" stroke-linecap="round" opacity=".9"/>
        </svg>
        <p class="art-text">Summer tune-ups<br/>now booking.</p>
      </div>
      <div class="ig-actions" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" fill="#e0445a"/></svg>
        <svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4Z" fill="none" stroke="#0d1b2a" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <svg viewBox="0 0 24 24"><path d="M21 4 3 11l7 2 2 7Z" fill="none" stroke="#0d1b2a" stroke-width="1.8" stroke-linejoin="round"/></svg>
      </div>
      <p class="cap"><b>yourbusiness</b> Book before the heat hits. Link in bio.</p>
      <div class="next" aria-hidden="true"><span class="av sm">YB</span><span class="l l1"></span></div>
    </div>
  </div>

  <div class="float ad">
    <span class="pulse" aria-hidden="true"></span>
    <span><b>Ad running</b><small>Facebook &amp; Instagram</small></span>
  </div>

  <div class="float cal">
    <p><b>This week</b><small>3 posts scheduled</small></p>
    <ol aria-hidden="true">
      {days.map((d, i) => <li class:list={{ on: posted.includes(i) }}>{d}</li>)}
    </ol>
  </div>

  <figcaption>Illustration</figcaption>
</figure>

<style>
  .hv { position: relative; margin: 0; width: 100%; max-width: 30rem; aspect-ratio: 1 / 1.08; justify-self: end; }
  .glow {
    position: absolute; inset: 6% 2% 4% 8%; border-radius: 40% 60% 55% 45% / 50% 45% 55% 50%;
    background: radial-gradient(closest-side, rgb(203 163 98 / 30%), rgb(34 81 110 / 10%) 60%, transparent);
    filter: blur(10px);
  }
  .phone {
    position: absolute; left: 50%; top: 0; transform: translateX(-46%);
    width: 58%; aspect-ratio: 9 / 17; padding: 3.2%;
    border-radius: 2.4rem; background: var(--navy-900);
    box-shadow: var(--shadow-lg), inset 0 0 0 2px rgb(255 255 255 / 8%);
  }
  .screen { height: 100%; border-radius: 1.9rem; background: var(--white); overflow: hidden; display: flex; flex-direction: column; }
  .ig-top { display: flex; align-items: center; gap: .5rem; padding: 1.35rem .75rem .6rem; }
  .av {
    width: 1.8rem; height: 1.8rem; border-radius: 50%; display: grid; place-items: center; flex: none;
    font-size: .6rem; font-weight: 800; color: var(--gold-500); background: var(--navy-800);
    box-shadow: 0 0 0 2px var(--white), 0 0 0 3.5px var(--gold-500);
  }
  .who { display: grid; line-height: 1.15; min-width: 0; }
  .who b { font-size: .72rem; color: var(--ink); }
  .who small { font-size: .6rem; color: var(--ink-faint); white-space: nowrap; }
  .dots { margin-left: auto; font-size: .6rem; color: var(--ink-faint); letter-spacing: .1em; }
  .art { position: relative; aspect-ratio: 1; overflow: hidden; }
  .art svg { width: 100%; height: 100%; }
  .art-text {
    position: absolute; left: 8%; top: 9%; color: var(--white);
    font-weight: 800; font-size: clamp(.85rem, 2.7vw, 1.2rem); line-height: 1.08; letter-spacing: -.03em;
  }
  .ig-actions { display: flex; gap: .55rem; padding: .6rem .75rem .35rem; }
  .ig-actions svg { width: 1.05rem; height: 1.05rem; }
  .cap { padding: .15rem .75rem .7rem; font-size: .68rem; line-height: 1.4; color: var(--ink); }
  .cap b { font-weight: 700; margin-right: .2rem; }
  .next { display: flex; align-items: center; gap: .5rem; padding: .6rem .75rem; border-top: 1px solid var(--line); margin-top: auto; }
  .av.sm { width: 1.4rem; height: 1.4rem; font-size: .5rem; }
  .l { display: block; height: .42rem; border-radius: 4px; background: var(--mist); }
  .l1 { width: 55%; }

  .float {
    position: absolute; background: var(--white); border-radius: 16px; box-shadow: var(--shadow);
    border: 1px solid rgb(7 40 63 / 6%);
  }
  .ad { left: 0; top: 44%; display: flex; align-items: center; gap: .65rem; padding: .75rem 1rem; }
  .ad b, .cal b { display: block; font-size: .82rem; color: var(--navy-800); line-height: 1.2; }
  .ad small, .cal small { display: block; font-size: .72rem; color: var(--ink-soft); }
  .pulse { width: .6rem; height: .6rem; border-radius: 50%; background: #2f9a6a; box-shadow: 0 0 0 4px rgb(47 154 106 / 18%); flex: none; }
  .cal { right: 0; bottom: 12%; padding: .85rem 1rem 1rem; display: grid; gap: .6rem; }
  .cal ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1.35rem); gap: .25rem; }
  .cal li {
    height: 1.6rem; border-radius: 6px; display: grid; place-items: center;
    font-size: .62rem; font-weight: 700; color: var(--ink-faint); background: var(--canvas);
  }
  .cal li.on { background: var(--navy-800); color: var(--gold-500); }
  figcaption {
    position: absolute; right: 0; bottom: 0; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ad { animation: bob 6s ease-in-out infinite; }
    .cal { animation: bob 7s ease-in-out -2s infinite; }
    .pulse { animation: ping 2.4s ease-out infinite; }
    @keyframes bob { 50% { transform: translateY(-8px); } }
    @keyframes ping { 0% { box-shadow: 0 0 0 0 rgb(47 154 106 / 35%); } 100% { box-shadow: 0 0 0 10px rgb(47 154 106 / 0%); } }
  }
  @media (max-width: 900px) { .hv { justify-self: center; max-width: 24rem; } }
  @media (max-width: 560px) {
    .hv { max-width: 21rem; aspect-ratio: 1 / 1.05; }
    .phone { width: 64%; transform: translateX(-50%); }
    .cal { display: none; }
    .ad { top: auto; bottom: 16%; left: -2%; padding: .6rem .85rem; }
    figcaption { right: -2%; }
  }
</style>
