---
import { cta } from '../data/site';
interface Props { eyebrow: string; title: string; lede: string; showCta?: boolean; track?: string }
const { eyebrow, title, lede, showCta = false, track = 'cta_page_hero' } = Astro.props;
---
<section class="page-hero">
  <div class="container inner">
    <span class="eyebrow reveal">{eyebrow}</span>
    <h1 class="reveal reveal-2">{title}</h1>
    <p class="lede reveal reveal-3">{lede}</p>
    {showCta && (
      <div class="btn-row reveal reveal-3">
        <a class="btn btn-primary arrow" href="/contact" data-track={track}>{cta.primary}</a>
      </div>
    )}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative; overflow: hidden;
    padding-block: clamp(3.5rem, 9vw, 6rem) clamp(3rem, 7vw, 4.5rem);
    background:
      radial-gradient(40rem 22rem at 92% -10%, rgb(203 163 98 / 16%), transparent 70%),
      radial-gradient(36rem 20rem at -5% 110%, rgb(203 163 98 / 7%), transparent 70%),
      var(--canvas);
    border-bottom: 1px solid var(--line);
  }
  .inner { display: grid; gap: 1.25rem; justify-items: start; position: relative; }
  h1 { font-size: clamp(2.3rem, 1.5rem + 3.4vw, 3.9rem); max-width: 16ch; }
</style>
