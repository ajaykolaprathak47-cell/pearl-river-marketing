---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/libre-caslon-text/latin-400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Adds noindex for draft pages such as legal drafts or 404. */
  noindex?: boolean;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}

const { title, description, noindex = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// Structured data: only verified fields from src/data/site.ts. No address, hours,
// coordinates or ratings are output because none have been confirmed.
const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: new URL('/', Astro.site).href,
  telephone: site.phone.e164,
  slogan: site.tagline,
  areaServed: [
    { '@type': 'City', name: 'Picayune, Mississippi' },
    { '@type': 'AdministrativeArea', name: 'Pearl River County, Mississippi' },
  ],
  knowsAbout: ['Facebook advertising', 'Instagram advertising', 'Social media content creation', 'Social media management'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'US',
    ...(site.streetAddress ? { streetAddress: site.streetAddress } : {}),
  },
  ...(site.email ? { email: site.email } : {}),
  ...(site.sameAs.length ? { sameAs: site.sameAs } : {}),
};
const jsonLd = [business, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/brand/logo-horizontal.webp" as="image" type="image/webp" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#10223a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pearl River Marketing: Turn Attention Into Growth. Digital advertising and social media content in Picayune, MS." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content="Pearl River Marketing: Turn Attention Into Growth." />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
