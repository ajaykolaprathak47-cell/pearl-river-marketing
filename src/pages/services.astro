---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import AdMock from '../components/AdMock.astro';
import CalendarMock from '../components/CalendarMock.astro';
import { serviceDetails } from '../data/serviceDetails';
import { site, realEstateLink } from '../data/site';

const serviceSchema = serviceDetails.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  description: s.lead,
  provider: { '@type': 'ProfessionalService', name: site.name },
  areaServed: [
    { '@type': 'City', name: 'Picayune, Mississippi' },
    { '@type': 'AdministrativeArea', name: 'Pearl River County, Mississippi' },
  ],
}));
---
<Base
  title="Advertising & Social Media Services"
  description="Two services for local businesses in Picayune and South Mississippi: Facebook and Instagram advertising, and social media content creation and posting."
  schema={serviceSchema}
>
  <PageHero
    eyebrow="Services"
    title="Two services, built to get you noticed."
    lede="We focus on Facebook and Instagram, and do two things there really well. Use one, or pair them."
  />

  {serviceDetails.map((s, i) => (
    <section id={s.id} class:list={['section', 'svc', { flip: i % 2 === 1 }]} aria-labelledby={`${s.id}-title`}>
      <div class="container svc-grid">
        <div class="copy">
          <div class="kicker"><ServiceIcon name={s.id} /><span>0{i + 1}</span></div>
          <h2 id={`${s.id}-title`}>{s.title}</h2>
          <p class="lede">{s.lead}</p>
          <ul class="check-list">{s.items.map((x) => <li>{x}</li>)}</ul>
          <p class="note">{s.note}</p>
          <a class="text-link arrow" href={`/contact?service=${s.id}`} data-track={`cta_service_${s.id}`}>{s.ctaLabel}</a>
        </div>
        <div class="visual">
          {s.id === 'advertising' ? <AdMock /> : <CalendarMock />}
        </div>
      </div>
    </section>
  ))}

  <section class="together">
    <div class="container together-inner">
      <p><strong>Better together.</strong> Ads bring new people to your page. Regular posts show them you're active and worth calling.</p>
      <a class="text-link arrow" href={realEstateLink.href}>Real estate agent? See how this works for listings</a>
    </div>
  </section>

  <CtaBand heading="Not sure where to start?" text="Tell us about your business. We'll recommend ads, content or both." track="cta_services_final" />
</Base>

<style>
  .svc { scroll-margin-top: 5rem; }
  .svc + .svc { background: var(--canvas); }
  .svc-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 7vw, 6rem); align-items: center; }
  .flip .copy { order: 2; }
  .copy { display: grid; gap: 1.25rem; justify-items: start; max-width: 32rem; }
  .kicker { display: flex; align-items: center; gap: .9rem; }
  .kicker span:last-child { font-weight: 700; color: var(--gold-700); letter-spacing: .1em; font-size: .85rem; }
  .copy h2 { font-size: clamp(1.9rem, 1.4rem + 2vw, 2.6rem); }
  .copy .check-list { margin-block: .25rem; }
  .note { font-size: .88rem; color: var(--ink-faint); max-width: 28rem; padding-left: .9rem; border-left: 2px solid var(--gold-100); }
  .visual { display: grid; }
  .together { border-block: 1px solid var(--line); }
  .together-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-block: 2rem; }
  .together-inner p { max-width: 38rem; color: var(--ink-soft); }
  .together-inner strong { color: var(--navy-800); }
  @media (max-width: 860px) {
    .svc-grid { grid-template-columns: 1fr; }
    .flip .copy { order: 0; }
  }
</style>
