---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { serviceDetails } from '../data/serviceDetails';
import { site, statusLabel } from '../data/site';

const serviceSchema = serviceDetails.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  description: s.summary,
  provider: { '@type': 'ProfessionalService', name: site.name },
  areaServed: [
    { '@type': 'City', name: 'Picayune, Mississippi' },
    { '@type': 'AdministrativeArea', name: 'Pearl River County, Mississippi' },
  ],
}));
---
<Base
  title="Website Design, Ads & Local SEO in Picayune, MS"
  description="Website design, Google Ads, Facebook and Instagram ads, Google Business Profile, landing pages and reporting for small businesses in Picayune, Pearl River County and South Mississippi."
  schema={serviceSchema}
>
  <PageHero
    eyebrow="Services"
    title="Practical marketing for local businesses."
    lede="A website that earns trust, ads that reach people nearby, and tracking that shows what came in. Each service below explains the problem it solves, what's included, who it's for, and how to request a quote."
    track="cta_services_hero"
  />

  <nav class="jump container" aria-label="Services on this page">
    <ul>
      {serviceDetails.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}
    </ul>
  </nav>

  <section class="container expectations">
    <div class="notice">
      <strong>About results:</strong> we don't guarantee leads, sales, rankings or return on ad spend. Results depend on your market, offer, budget, competition and how quickly new inquiries are followed up. We'll tell you plainly what we think is realistic before you spend anything.
    </div>
  </section>

  {serviceDetails.map((s, i) => (
    <section id={s.id} class:list={['section', 'service', { 'section--paper': i % 2 === 1 }]} aria-labelledby={`${s.id}-title`}>
      <div class="container service-grid">
        <div class="service-intro">
          {s.status === 'limited' && <span class="badge badge--limited">{statusLabel.limited}</span>}
          <h2 id={`${s.id}-title`}>{s.name}</h2>
          <div class="problem">
            <h3 class="label">The problem</h3>
            <p>{s.problem}</p>
          </div>
          <p class="lede">{s.summary}</p>
          <div class="who">
            <h3 class="label">Who it's for</h3>
            <p>{s.whoFor}</p>
          </div>
          {s.status === 'limited' && (
            <p class="muted small">We are taking a limited number of these projects while this service grows. Ask about it in your consultation.</p>
          )}
          <div class="quote">
            <a class="btn btn-primary arrow" href={`/contact?service=${s.id}`} data-track={`cta_service_${s.id}`}>{s.ctaLabel}</a>
            <p class="muted small">Free and no obligation. You get a written quote before any work starts.</p>
          </div>
        </div>
        <div class="service-body">
          <div>
            <h3 class="label">What's included</h3>
            <ul class="check-list">{s.included.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div>
            <h3 class="label">How it works</h3>
            <ol class="how">{s.howItWorks.map((x) => <li>{x}</li>)}</ol>
          </div>
          <div>
            <h3 class="label">What we need from you</h3>
            <ul class="check-list">{s.youProvide.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>
  ))}

  <CtaBand heading="Not sure which of these you need?" text="That's what the free consultation is for. Tell us about your business and goals, and we'll recommend where to start, including what not to spend money on yet." track="cta_services_final" showWebsiteQuote />
</Base>

<style>
  .jump { padding-block: 1.5rem .5rem; }
  .jump ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .jump a {
    display: inline-block; padding: .45rem .9rem; border: 1px solid var(--line); border-radius: 999px;
    font-size: .9rem; text-decoration: none; color: var(--ink); transition: border-color .2s, color .2s;
  }
  .jump a:hover { border-color: var(--gold-600); color: var(--gold-700); }
  .expectations { padding-block: 1rem 0; }
  .service { scroll-margin-top: 5rem; }
  .service-grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .service-intro { display: grid; gap: 1.25rem; justify-items: start; position: sticky; top: 6rem; }
  .service-body { display: grid; gap: 2.25rem; }
  .label {
    font-family: var(--font-body); font-size: .78rem; font-weight: 650; letter-spacing: .14em; text-transform: uppercase;
    color: var(--gold-700); margin-bottom: .85rem;
  }
  .who .label, .problem .label { margin-bottom: .4rem; }
  .problem { border-left: 3px solid var(--gold-600); padding-left: 1rem; }
  .problem p { color: var(--ink); }
  .quote { display: grid; gap: .6rem; justify-items: start; }
  .how { margin: 0; padding: 0; list-style: none; counter-reset: how; display: grid; gap: .8rem; }
  .how li { counter-increment: how; display: grid; grid-template-columns: 2rem 1fr; gap: .5rem; }
  .how li::before {
    content: counter(how); width: 1.6rem; height: 1.6rem; border-radius: 50%; display: grid; place-items: center;
    font-size: .8rem; font-weight: 700; background: var(--navy-800); color: var(--white); margin-top: .1rem;
  }
  .small { font-size: .9rem; }
  @media (max-width: 900px) {
    .service-grid { grid-template-columns: 1fr; }
    .service-intro { position: static; }
  }
</style>
