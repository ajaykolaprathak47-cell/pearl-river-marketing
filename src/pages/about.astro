---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import OwnerCard from '../components/OwnerCard.astro';
import { site, owner } from '../data/site';

const personSchema = owner.name
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: owner.name,
      jobTitle: owner.title,
      worksFor: { '@type': 'ProfessionalService', name: site.name },
    }]
  : [];

const values = [
  { t: 'You work with the owner', d: 'No hand-offs. The person you talk to is the person doing the work.' },
  { t: 'You approve everything', d: 'No post or ad goes live until you’ve seen it and said yes.' },
  { t: 'You own your accounts', d: 'Your pages, ad account and content stay in your business’s name.' },
];
---
<Base
  title="About Pearl River Marketing | Picayune, MS"
  description="Pearl River Marketing is a locally owned digital marketing agency in Picayune, Mississippi, focused on Facebook and Instagram advertising and social media content."
  schema={personSchema}
>
  <PageHero
    eyebrow="About"
    title="Local, hands-on and focused."
    lede="A new digital marketing agency in Picayune, Mississippi, helping local businesses get noticed online."
  />

  <section class="section">
    <div class="container about">
      <OwnerCard />

      <div class="why">
        <h2>Why we do just two things</h2>
        <p class="lede">Most local owners know social media matters. The hard part is posting consistently and knowing whether ad money did anything. So we focus on ads and content, and do them well.</p>
      </div>

      <ul class="values">
        {values.map((v) => (
          <li>
            <h3>{v.t}</h3>
            <p class="muted">{v.d}</p>
          </li>
        ))}
      </ul>

      <p class="honest">We’re new, and upfront about it: no borrowed logos or made-up numbers. Real client work will be shared here, with permission, as it’s completed.</p>
    </div>
  </section>

  <CtaBand track="cta_about_final" />
</Base>

<style>
  .about { display: grid; gap: clamp(3rem, 7vw, 4.5rem); max-width: 60rem; }
  .why { display: grid; gap: 1rem; max-width: 40rem; }
  .why h2 { font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.3rem); }
  .values { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .values li { display: grid; gap: .5rem; align-content: start; padding: 1.5rem; border-radius: 18px; background: var(--canvas); }
  .values h3 { font-size: 1.15rem; }
  .honest { font-size: .95rem; color: var(--ink-soft); max-width: 40rem; padding-left: 1rem; border-left: 2px solid var(--gold-600); }
  @media (max-width: 800px) { .values { grid-template-columns: 1fr; } }
</style>
