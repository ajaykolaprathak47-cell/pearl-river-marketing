---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import OwnerCard from '../components/OwnerCard.astro';
import { site, owner } from '../data/site';

const personSchema = owner.name
  ? [{
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: owner.name,
      jobTitle: owner.title,
      worksFor: { '@type': 'ProfessionalService', name: site.name },
    }]
  : [];
---
<Base
  title="About Pearl River Marketing | Picayune, MS"
  description="Pearl River Marketing is a locally owned digital marketing agency in Picayune, Mississippi, specializing in Facebook and Instagram advertising and social media content for small businesses."
  schema={personSchema}
>
  <PageHero
    eyebrow="About"
    title="A local digital marketing partner, based in Picayune."
    lede="Pearl River Marketing is a new, locally owned agency that does two things: digital advertising and social media content. We help small businesses in Pearl River County and South Mississippi get noticed and stay visible online."
    showCta={false}
  />

  <section class="section">
    <div class="container about-grid">
      <div class="main">
        <OwnerCard />

        <div class="prose">
          <h2>Why Pearl River Marketing</h2>
          <p>Most local business owners know social media matters. The hard part is finding time to post consistently, and knowing whether money spent on "boosted" posts actually did anything.</p>
          <p>Pearl River Marketing was started to take that off their plate for businesses close to home. We focus on just two services, advertising and social media content, so we can do them well, keep things simple, and be straight about what's working and what isn't.</p>

          <h2>How we work</h2>
          <ul>
            <li><strong>Clear communication.</strong> Answers in plain English, from the person doing the work.</li>
            <li><strong>You approve everything.</strong> No ad or post goes out on your pages without your OK.</li>
            <li><strong>Transparent reporting.</strong> Clear reports on what was spent, what the ads did, and what we're changing.</li>
            <li><strong>Your accounts, your content.</strong> Your pages and ad account stay in your business's name.</li>
            <li><strong>Honest recommendations.</strong> If something isn't worth your money yet, we'll say so.</li>
          </ul>

          <h2>A new agency, and upfront about it</h2>
          <p>We're just getting started, so you won't find borrowed client logos or inflated numbers here. What you will get is careful work, direct attention and honest reporting. As we complete projects, we'll share real examples with our clients' permission.</p>
        </div>
      </div>

      <aside class="facts card" aria-label="At a glance">
        <h2 class="facts-title">At a glance</h2>
        <dl>
          <div><dt>Based in</dt><dd>{site.city}, {site.regionName}</dd></div>
          <div><dt>Service area</dt><dd>{site.serviceArea}; remote work available</dd></div>
          <div><dt>Services</dt><dd>Digital advertising (Facebook & Instagram) and social media content creation & posting</dd></div>
          <div><dt>Who we serve</dt><dd>Contractors and home-service businesses, real estate agents, and other local small businesses</dd></div>
          <div><dt>Phone</dt><dd><a href={`tel:${site.phone.e164}`} data-track="phone_click">{site.phone.display}</a></dd></div>
          {site.email && <div><dt>Email</dt><dd><a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a></dd></div>}
        </dl>
      </aside>
    </div>
  </section>

  <CtaBand track="cta_about_final" showQuote />
</Base>

<style>
  .about-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .8fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .main { display: grid; gap: var(--space-4); }
  .facts { position: sticky; top: 6rem; background: var(--paper); }
  .facts-title { font-size: 1.4rem; }
  dl { margin: 0; display: grid; gap: 0; }
  dl div { padding-block: .85rem; border-top: 1px solid var(--line); display: grid; gap: .2rem; }
  dt { font-size: .75rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-700); }
  dd { margin: 0; }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; } .facts { position: static; } }
</style>
