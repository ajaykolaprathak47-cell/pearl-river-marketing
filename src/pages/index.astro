---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Showcase from '../components/Showcase.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, cta } from '../data/site';

const steps = [
  { t: "Let's Talk", d: 'A free, no-pressure conversation about your business and goals.' },
  { t: 'Create Your Strategy', d: 'We plan your ads and content. You approve everything first.' },
  { t: 'Launch & Grow', d: 'We publish, monitor and keep improving, with clear updates.' },
];
---
<Base
  title="Pearl River Marketing | Facebook & Instagram Ads in Picayune, MS"
  description="Pearl River Marketing helps local businesses in Picayune and South Mississippi grow with Facebook and Instagram advertising and professional social media content."
>
  <!-- 1. Hero -->
  <section class="hero">
    <svg class="hero-river" viewBox="0 0 1440 700" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-40 560 C 240 470, 420 640, 720 540 S 1180 380, 1480 460" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M-40 610 C 260 520, 460 690, 760 590 S 1200 430, 1480 510" fill="none" stroke="currentColor" stroke-width="1"/>
    </svg>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow reveal">Digital marketing · Picayune, MS</span>
        <h1 class="reveal reveal-2">Turn attention into <span class="accent">growth.</span></h1>
        <p class="lede reveal reveal-3">We help local businesses in South Mississippi grow their online presence with Facebook &amp; Instagram advertising and professional social media content.</p>
        <div class="btn-row reveal reveal-4">
          <a class="btn btn-primary arrow" href="/contact" data-track="cta_hero">{cta.primary}</a>
          <a class="btn btn-outline" href="/services" data-track="cta_hero_services">{cta.secondary}</a>
        </div>
        <p class="for reveal reveal-4">For contractors, home services, real estate agents and local shops.</p>
      </div>
      <HeroVisual />
    </div>
  </section>

  <!-- 2. Services -->
  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2 id="services-title">Two services. Done right.</h2>
      </div>
      <div class="svc-grid">
        {services.map((s) => (
          <a class="card svc" href={`/services#${s.id}`}>
            <ServiceIcon name={s.id} />
            <h3>{s.id === 'social-media' ? 'Social Media Content' : s.name}</h3>
            <p class="muted">{s.short}</p>
            <span class="text-link arrow">Learn more</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Showcase -->
  <section class="section section--canvas" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head showcase-head">
        <span class="eyebrow">Sample work</span>
        <h2 id="work-title">Content made to stop the scroll.</h2>
        <p class="muted">Demonstration concepts that show our style. Not real clients or results.</p>
      </div>
      <Showcase />
    </div>
  </section>

  <!-- 4. Process -->
  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">How it works</span>
        <h2 id="how-title">Three simple steps.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="n">{i + 1}</span>
            <h3>{s.t}</h3>
            <p class="muted">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Final CTA -->
  <CtaBand track="cta_home_final" />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative; overflow: hidden;
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3.5rem, 8vw, 6rem);
    background:
      radial-gradient(46rem 30rem at 88% 20%, rgb(203 163 98 / 14%), transparent 70%),
      radial-gradient(40rem 26rem at 0% 100%, rgb(34 81 110 / 9%), transparent 70%),
      linear-gradient(180deg, var(--canvas), var(--bg));
  }
  .hero-river { position: absolute; inset: 0; width: 100%; height: 100%; color: rgb(184 140 69 / 28%); pointer-events: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(2.5rem, 6vw, 4rem); align-items: center; }
  .hero-copy { display: grid; gap: 1.5rem; justify-items: start; }
  .hero h1 { max-width: 11ch; }
  .hero h1 .accent { color: var(--gold-700); letter-spacing: -.02em; }
  .for { font-size: .92rem; color: var(--ink-faint); }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { justify-items: stretch; }
    .hero-copy .eyebrow, .hero-copy h1, .hero-copy .lede, .for { justify-self: start; }
  }
  @media (max-width: 520px) {
    .hero-copy .btn-row { flex-direction: column; }
    .hero-copy .btn { width: 100%; }
  }

  /* Services */
  .svc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 1.5rem); }
  .svc { gap: 1.1rem; padding: clamp(1.75rem, 4vw, 2.75rem); position: relative; overflow: hidden; }
  .svc::after {
    content: ''; position: absolute; right: -4rem; top: -4rem; width: 12rem; height: 12rem; border-radius: 50%;
    border: 1.5px solid rgb(203 163 98 / 35%); transition: transform .5s var(--ease);
  }
  .svc:hover::after { transform: scale(1.12); }
  .svc h3 { font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem); margin-top: .5rem; }
  .svc p { max-width: 30rem; }
  .svc .text-link { margin-top: auto; padding-top: .5rem; }
  @media (max-width: 760px) { .svc-grid { grid-template-columns: 1fr; } }

  /* Showcase */
  .showcase-head { max-width: 34rem; }

  /* Process */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 3rem); position: relative; }
  .steps::before {
    content: ''; position: absolute; top: 1.5rem; left: 16%; right: 16%; height: 1px;
    background: repeating-linear-gradient(90deg, var(--gold-600) 0 6px, transparent 6px 12px); opacity: .6;
  }
  .steps li { position: relative; display: grid; gap: .6rem; justify-items: center; text-align: center; }
  .n {
    width: 3rem; height: 3rem; border-radius: 50%; display: grid; place-items: center; margin-bottom: .6rem;
    font-weight: 750; color: var(--navy-800); background: var(--white); border: 1.5px solid var(--gold-600);
    box-shadow: 0 0 0 6px var(--bg);
  }
  .steps h3 { font-size: 1.3rem; }
  .steps p { max-width: 17rem; }
  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps::before { top: 1.5rem; bottom: 1.5rem; left: 1.5rem; right: auto; width: 1px; height: auto; background: repeating-linear-gradient(180deg, var(--gold-600) 0 6px, transparent 6px 12px); }
    .steps li { grid-template-columns: 3rem 1fr; justify-items: start; text-align: left; column-gap: 1.1rem; row-gap: .2rem; padding-bottom: 1.75rem; }
    .n { grid-row: span 2; margin: 0; }
    .steps h3 { align-self: end; }
  }
</style>
