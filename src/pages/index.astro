---
import Base from '../layouts/Base.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import SampleCampaign from '../components/SampleCampaign.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, statusLabel, site } from '../data/site';
import { homeFaq } from '../data/faq';
---
<Base
  title="Pearl River Marketing | Marketing Agency in Picayune, MS"
  description="Google Ads, Facebook and Instagram ads, landing pages and clear reporting for local businesses and real estate professionals in Picayune and Pearl River County, Mississippi."
>
  <!-- Hero -->
  <section class="hero on-navy">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow reveal">Marketing agency · {site.city}, {site.region}</span>
        <h1 class="reveal reveal-2">Turn Attention <em>Into Growth.</em></h1>
        <p class="lede reveal reveal-3">Pearl River Marketing helps local businesses reach more of the right customers through targeted advertising, stronger websites, and lead generation you can actually measure.</p>
        <div class="btn-row reveal reveal-3">
          <a class="btn btn-primary arrow" href="/contact" data-track="cta_hero">Book a Free Consultation</a>
          <a class="btn btn-outline" href="/services" data-track="cta_hero_services">Explore Our Services</a>
        </div>
        <p class="hero-note">Free, no-obligation consultation. Honest advice, even if the answer is "not yet."</p>
      </div>
      <HeroIllustration />
    </div>
  </section>

  <!-- Who we serve -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who we work with</span>
        <h2>Built for businesses that depend on local customers.</h2>
        <p class="lede">If people in your area need what you do, they are already searching and scrolling. Our job is to make sure they find you, and that it is easy for them to reach out.</p>
      </div>
      <div class="grid grid-3 audiences">
        <div class="audience">
          <h3>Local service businesses</h3>
          <p class="muted">Roofing, HVAC, plumbing, landscaping, contractors and other home services that live on phone calls and booked jobs.</p>
        </div>
        <div class="audience">
          <h3>Real estate professionals</h3>
          <p class="muted">Brokerages, agents and property businesses looking for more buyer and seller inquiries, run within fair housing ad rules.</p>
          <a class="arrow text-link" href="/real-estate-marketing">Real estate marketing</a>
        </div>
        <div class="audience">
          <h3>Other small businesses</h3>
          <p class="muted">Shops, clinics, restaurants and professional offices in Picayune, Pearl River County and nearby South Mississippi communities.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--paper">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2>What we do</h2>
        <p class="lede">Paid advertising is our core work. The rest supports it, because ads only pay off when there is a good page to land on and a clear way to measure what happened.</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a class="card" href={`/services#${s.id}`}>
            <span class:list={['badge', `badge--${s.status}`]}>{statusLabel[s.status]}</span>
            <h3 class="card-title">{s.name}</h3>
            <p class="muted">{s.short}</p>
            <span class="arrow text-link" aria-hidden="true">Learn more</span>
          </a>
        ))}
      </div>
      <div class="btn-row center">
        <a class="btn btn-dark arrow" href="/contact" data-track="cta_services">Book a Free Consultation</a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>Three steps, in this order.</h2>
      </div>
      <ol class="steps">
        <li>
          <span class="step-n">1</span>
          <h3>Discover</h3>
          <p class="muted">We learn your business, your best customers, your service area and what you have tried before. Then we look at your market and competitors and recommend where to start.</p>
        </li>
        <li>
          <span class="step-n">2</span>
          <h3>Build</h3>
          <p class="muted">We set up tracking, campaigns and any landing pages under your accounts. You review and approve everything before a dollar of ad budget is spent.</p>
        </li>
        <li>
          <span class="step-n">3</span>
          <h3>Optimize</h3>
          <p class="muted">We watch results closely, cut what is not working, and put budget behind what is. Each month you get a clear report and a short call about next steps.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Local partner -->
  <section class="section on-navy local">
    <div class="container local-grid">
      <div class="section-head">
        <span class="eyebrow">Why a local partner</span>
        <h2>You work with the person doing the work.</h2>
        <p class="lede">We are a small, focused agency in {site.city}. That shapes how we work with you.</p>
      </div>
      <ul class="benefits">
        <li>
          <h3>Direct communication</h3>
          <p>No account manager passing messages along. You talk to the person building and running your campaigns.</p>
        </li>
        <li>
          <h3>We know the area</h3>
          <p>We live and work in Pearl River County, and we can meet in person when that helps.</p>
        </li>
        <li>
          <h3>Plain-English reporting</h3>
          <p>You will always know what was spent, what came in, and what we are changing next.</p>
        </li>
        <li>
          <h3>You own everything</h3>
          <p>Ad accounts, pages and data are set up in your name and stay with you.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Proof / sample -->
  <section class="section section--paper">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our work</span>
        <h2>How we plan a campaign</h2>
        <p class="lede">Pearl River Marketing is a new agency, so instead of borrowed logos or made-up numbers, here is a sample of how we plan the work. Real client examples will be added here, with permission, as they come in.</p>
      </div>
      <SampleCampaign />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-grid">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Common questions</h2>
        <p class="muted">Something else on your mind? Call or text <a href={`tel:${site.phone.e164}`} data-track="phone_click">{site.phone.display}</a>.</p>
      </div>
      <Faq items={homeFaq} />
    </div>
  </section>

  <CtaBand track="cta_home_final" />
</Base>

<style>
  .hero { padding-block: clamp(3.5rem, 8vw, 6rem) clamp(3.5rem, 8vw, 5.5rem); position: relative; overflow: hidden; }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(60rem 30rem at 85% 110%, rgb(201 162 74 / 14%), transparent 60%),
      linear-gradient(180deg, var(--navy-900), var(--navy-800));
    pointer-events: none;
  }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .hero-copy { display: grid; gap: 1.5rem; justify-items: start; }
  .hero h1 em { font-style: italic; color: var(--gold-500); }
  .hero-note { font-size: .88rem; color: #9fb0c5; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }

  .audiences { gap: 0; border-top: 2px solid var(--navy-800); }
  .audience { padding: 1.75rem 1.5rem 0 0; display: grid; gap: .75rem; align-content: start; }
  .audience + .audience { padding-left: 1.5rem; border-left: 1px solid var(--line); }
  .audience h3 { font-size: 1.4rem; }
  @media (max-width: 860px) {
    .audience, .audience + .audience { padding: 1.5rem 0; border-left: 0; border-bottom: 1px solid var(--line); }
  }

  .card-title { font-size: 1.35rem; }
  .text-link { color: var(--gold-700); font-weight: 600; font-size: .95rem; text-decoration: none; display: inline-flex; gap: .4rem; margin-top: auto; }
  .center { justify-content: center; margin-top: var(--space-4); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); counter-reset: none; }
  .steps li { display: grid; gap: .8rem; align-content: start; position: relative; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .step-n {
    width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center;
    font-family: var(--font-display); font-size: 1.2rem; color: var(--navy-800); border: 1.5px solid var(--gold-600);
  }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }

  .local-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .benefits { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 2.5rem; }
  .benefits li { display: grid; gap: .5rem; padding-top: 1.1rem; border-top: 1px solid rgb(201 162 74 / 45%); }
  .benefits h3 { font-size: 1.3rem; }
  .benefits p { color: #c8d3e2; font-size: .98rem; }
  @media (max-width: 900px) { .local-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .benefits { grid-template-columns: 1fr; } }

  .faq-grid { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
