---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SERVICE_OPTIONS, LIMITS } from '../lib/consultation';
import { site, cta } from '../data/site';
---
<Base
  title="Get a Free Consultation"
  description={`Request a free marketing consultation or an advertising or social media quote from ${site.name} in Picayune, MS. Or call or text ${site.phone.display}.`}
>
  <PageHero
    eyebrow="Contact"
    title="Let's talk."
    lede="Tell us a little about your business. We'll reach out to set up a free, no-obligation consultation."
  >
    <p class="hero-phone">Prefer to talk now? Call or text <a href={`tel:${site.phone.e164}`} data-track="phone_click">{site.phone.display}</a></p>
  </PageHero>

  <section class="section section--canvas">
    <div class="container contact-grid">
      <div class="form-wrap">
        <form id="consult-form" novalidate aria-describedby="form-intro">
          <p id="form-intro" class="muted small">Takes about two minutes. Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>

          <div class="error-summary" id="error-summary" tabindex="-1" hidden>
            <h2>Please fix the following</h2>
            <ul></ul>
          </div>

          <div class="row">
            <div class="field">
              <label for="name">Your name <span aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength={LIMITS.name} aria-describedby="name-error" />
              <p class="field-error" id="name-error"></p>
            </div>
            <div class="field">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength={LIMITS.email} aria-describedby="email-error" />
              <p class="field-error" id="email-error"></p>
            </div>
          </div>

          <div class="row">
            <div class="field">
              <label for="business">Business name <span aria-hidden="true">*</span></label>
              <input id="business" name="business" type="text" autocomplete="organization" required maxlength={LIMITS.business} aria-describedby="business-error" />
              <p class="field-error" id="business-error"></p>
            </div>
            <div class="field">
              <label for="website">Website or Facebook page <span class="optional">(optional)</span></label>
              <input id="website" name="website" type="text" autocomplete="url" inputmode="url" placeholder="facebook.com/yourbusiness" maxlength={LIMITS.website} aria-describedby="website-error" />
              <p class="field-error" id="website-error"></p>
            </div>
          </div>

          <div class="field">
            <label for="phone">Phone <span class="optional">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength={LIMITS.phone} aria-describedby="phone-error" />
            <p class="field-error" id="phone-error"></p>
          </div>

          <fieldset class="field" aria-describedby="services-error">
            <legend>What are you interested in? <span aria-hidden="true">*</span></legend>
            <div class="checks">
              {SERVICE_OPTIONS.map((o) => (
                <label class="check" for={`svc-${o.value}`}>
                  <input type="checkbox" id={`svc-${o.value}`} name="services" value={o.value} />
                  <span>{o.label}</span>
                </label>
              ))}
            </div>
            <p class="field-error" id="services-error"></p>
          </fieldset>

          <div class="field">
            <label for="message">Tell us about your business <span aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="5" required maxlength={LIMITS.message} aria-describedby="message-hint message-error"></textarea>
            <p class="hint" id="message-hint">What you do and what you'd like help with.</p>
            <p class="field-error" id="message-error"></p>
          </div>

          <!-- Spam trap: hidden from people and assistive tech. -->
          <div class="trap" aria-hidden="true">
            <label for="company-fax">Leave this field empty</label>
            <input id="company-fax" name="trap" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="field">
            <label class="check consent" for="consent">
              <input type="checkbox" id="consent" name="consent" required aria-describedby="consent-error" />
              <span>I agree that {site.name} may use these details to respond to my inquiry, as described in the <a href="/privacy">Privacy Policy</a>. <span aria-hidden="true">*</span></span>
            </label>
            <p class="field-error" id="consent-error"></p>
          </div>

          <div class="submit-row">
            <button class="btn btn-primary" type="submit" id="submit-btn">
              <span class="spinner" aria-hidden="true"></span>
              <span class="btn-label">{cta.primary}</span>
            </button>
            <p class="small muted">We won't add you to a mailing list.</p>
          </div>

          <p class="visually-hidden" id="form-live" role="status" aria-live="polite"></p>
          <div class="status status--error" id="form-error" role="alert" tabindex="-1" hidden></div>
        </form>

        <div class="status status--success" id="form-success" tabindex="-1" hidden>
          <h2>Thank you. Your request was sent.</h2>
          <p>We'll read it, look at your business, and reach out to set up a conversation. If you'd like to talk sooner, call or text <a href={`tel:${site.phone.e164}`} data-track="phone_click">{site.phone.display}</a>.</p>
        </div>
      </div>

      <aside class="side">
        <div class="next">
          <h2 class="side-title">What happens next</h2>
          <ol>
            <li><span>1</span>We look at your business and your current pages.</li>
            <li><span>2</span>We reach out to set up a short call.</li>
            <li><span>3</span>If it's a fit, you get a written quote. No pressure.</li>
          </ol>
        </div>
        <div class="side-card">
          <p class="side-k">Call or text</p>
          <p class="phone"><a href={`tel:${site.phone.e164}`} data-track="phone_click">{site.phone.display}</a></p>
          {site.email && (
            <p><a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a></p>
          )}
          <p class="muted small">{site.city}, {site.regionName}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .hero-phone { color: var(--ink-soft); }
  .hero-phone a { font-weight: 700; white-space: nowrap; color: var(--navy-800); }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr); gap: clamp(2rem, 5vw, 3.5rem); align-items: start; }
  .form-wrap { background: var(--white); border-radius: 22px; padding: clamp(1.5rem, 4vw, 2.5rem); box-shadow: var(--shadow); border: 1px solid rgb(7 40 63 / 6%); }
  .side { display: grid; gap: 1.5rem; position: sticky; top: 6.5rem; }
  .side-card { display: grid; gap: .25rem; padding: 1.5rem; border-radius: 18px; background: var(--navy-800); color: #c6d1de; }
  .side-card .muted { color: #9fb0c3; }
  .side-card a { color: var(--white); }
  .side-k { font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-500); }
  .side-title { font-size: 1.2rem; margin-bottom: .25rem; }
  .phone { font-size: 1.6rem; font-weight: 750; letter-spacing: -.02em; }
  .phone a { text-decoration: none; }
  .next ol { list-style: none; margin: .75rem 0 0; padding: 0; display: grid; gap: .8rem; color: var(--ink-soft); font-size: .97rem; }
  .next li { display: grid; grid-template-columns: 1.75rem 1fr; gap: .6rem; }
  .next li span { width: 1.75rem; height: 1.75rem; border-radius: 50%; display: grid; place-items: center; font-size: .8rem; font-weight: 750; color: var(--navy-800); border: 1.5px solid var(--gold-600); }
  .small { font-size: .9rem; }

  form { display: grid; gap: 1.4rem; }
  .row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem; }
  .field { display: grid; gap: .4rem; min-width: 0; margin: 0; padding: 0; border: 0; }
  label, legend { font-weight: 600; font-size: .95rem; padding: 0; }
  legend { margin-bottom: .6rem; }
  .optional { font-weight: 400; color: var(--ink-soft); }
  input[type='text'], input[type='email'], input[type='tel'], textarea {
    width: 100%; font: inherit; font-size: 1rem; color: var(--ink); min-height: 3rem;
    padding: .8rem .9rem; border: 1.5px solid #cfd6df; border-radius: 12px; background: var(--white);
    transition: border-color .15s, box-shadow .15s;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--navy-700); box-shadow: 0 0 0 3px rgb(181 140 50 / 35%); }
  [aria-invalid='true'] { border-color: var(--err) !important; }
  textarea { resize: vertical; min-height: 8rem; }
  .hint { font-size: .87rem; color: var(--ink-soft); }
  .field-error { font-size: .9rem; color: var(--err); font-weight: 550; }
  .field-error:empty { display: none; }
  .checks { display: grid; grid-template-columns: 1fr; gap: .25rem; }
  .check { display: flex; gap: .65rem; align-items: flex-start; font-weight: 450; cursor: pointer; line-height: 1.4; padding-block: .45rem; }
  .check input { width: 1.25rem; height: 1.25rem; margin: 0; accent-color: var(--navy-800); flex: none; }
  .consent { font-size: .95rem; }
  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .submit-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .spinner { display: none; width: 1rem; height: 1rem; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .8s linear infinite; }
  .btn[aria-busy='true'] .spinner { display: inline-block; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .error-summary { border: 2px solid var(--err); border-radius: var(--radius); padding: 1rem 1.25rem; background: var(--err-bg); scroll-margin-top: 6rem; }
  .error-summary h2 { font-family: var(--font-body); font-size: 1rem; font-weight: 700; color: var(--err); }
  .error-summary ul { margin: .5rem 0 0; padding-left: 1.2rem; }
  .error-summary a { color: var(--err); }
  .status { border-radius: var(--radius); padding: 1.25rem 1.5rem; scroll-margin-top: 6rem; }
  .status--error { background: var(--err-bg); border: 1px solid var(--err); color: var(--ink); }
  .status--success { background: var(--ok-bg); border: 1px solid var(--ok); display: grid; gap: .6rem; }
  .status--success[hidden], .status--error[hidden] { display: none; }
  .status--success h2 { font-size: 1.6rem; color: var(--ok); }

  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } .side { position: static; } }
  @media (max-width: 560px) { .form-wrap { margin-inline: -.5rem; } .submit-row .btn { width: 100%; } }
  @media (max-width: 600px) { .row { grid-template-columns: 1fr; } }
</style>

<script>
  import { normalize, validate, type FieldErrors } from '../lib/consultation';
  import { site, cta } from '../data/site';
  import { track } from '../lib/analytics';

  const form = document.getElementById('consult-form') as HTMLFormElement | null;
  if (form) {
    const startedAt = Date.now();
    // One id per page view. Resend ignores repeat sends with the same id for 24 hours,
    // so a retry after a timeout cannot create a second email.
    const submissionId =
      typeof crypto !== 'undefined' && 'randomUUID' in crypto
        ? crypto.randomUUID()
        : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;

    // Preselect a service when arriving from a service's quote link.
    const pre = new URLSearchParams(location.search).get('service');
    if (pre) {
      const box = form.querySelector<HTMLInputElement>(`input[name="services"][value="${CSS.escape(pre)}"]`);
      if (box) box.checked = true;
    }

    const summary = document.getElementById('error-summary')!;
    const errorBox = document.getElementById('form-error')!;
    const success = document.getElementById('form-success')!;
    const live = document.getElementById('form-live')!;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnLabel = btn.querySelector('.btn-label')!;
    const fieldIds: Record<string, string> = { services: 'svc-advertising' };
    let inFlight = false;
    let sent = false;

    const collect = () => {
      const fd = new FormData(form);
      return {
        name: fd.get('name'), email: fd.get('email'), business: fd.get('business'),
        website: fd.get('website'), phone: fd.get('phone'), services: fd.getAll('services'),
        message: fd.get('message'), consent: fd.get('consent') === 'on',
        trap: fd.get('trap'), startedAt, submissionId,
      };
    };

    const clearErrors = () => {
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      form.querySelectorAll('.field-error').forEach((el) => (el.textContent = ''));
      summary.hidden = true;
      errorBox.hidden = true;
    };

    const showErrors = (errors: FieldErrors) => {
      const list = summary.querySelector('ul')!;
      list.innerHTML = '';
      for (const [key, message] of Object.entries(errors)) {
        const msgEl = document.getElementById(`${key}-error`);
        if (msgEl) msgEl.textContent = message ?? '';
        const inputId = fieldIds[key] ?? key;
        if (key !== 'services') document.getElementById(inputId)?.setAttribute('aria-invalid', 'true');
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${inputId}`;
        a.textContent = message ?? '';
        a.addEventListener('click', (e) => { e.preventDefault(); document.getElementById(inputId)?.focus(); });
        li.append(a);
        list.append(li);
      }
      summary.hidden = false;
      summary.focus({ preventScroll: true });
      summary.scrollIntoView({ block: 'start', behavior: 'smooth' });
    };

    // Clear a field's error as soon as the visitor fixes it.
    form.addEventListener('input', (e) => {
      const el = e.target as HTMLElement;
      const key = el.getAttribute('name') === 'services' ? 'services' : el.id;
      const msg = document.getElementById(`${key}-error`);
      if (msg?.textContent) { msg.textContent = ''; el.removeAttribute('aria-invalid'); }
    });

    const callLine = `<a href="tel:${site.phone.e164}">call or text ${site.phone.display}</a>`;
    const showFailure = (html: string) => {
      errorBox.innerHTML = html;
      errorBox.hidden = false;
      errorBox.focus({ preventScroll: true });
      errorBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    const setBusy = (busy: boolean) => {
      inFlight = busy;
      btn.disabled = busy;
      btn.setAttribute('aria-busy', String(busy));
      btnLabel.textContent = busy ? 'Sending…' : cta.primary;
      live.textContent = busy ? 'Sending your request.' : '';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (inFlight || sent) return; // blocks double-clicks and repeat submits
      clearErrors();
      const data = collect();
      const errors = validate(normalize(data));
      if (Object.keys(errors).length) { showErrors(errors); return; }

      setBusy(true);
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 20_000);
      try {
        const res = await fetch('/api/consultation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          signal: controller.signal,
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.ok) {
          sent = true;
          track('consultation_submit');
          form.hidden = true;
          success.hidden = false;
          success.focus({ preventScroll: true });
          success.scrollIntoView({ block: 'center', behavior: 'smooth' });
          return;
        }
        if (res.status === 400 && body.fieldErrors) { showErrors(body.fieldErrors); return; }
        if (res.status === 503) {
          showFailure(`<strong>Online requests aren't switched on yet.</strong> Your details were not sent. Please ${callLine} and we'll set up your consultation.`);
          return;
        }
        showFailure(`<strong>Your request couldn't be sent.</strong> Your details are still in the form. Please try again in a minute, or ${callLine}.`);
      } catch {
        showFailure(`<strong>We couldn't reach the server.</strong> Check your connection and try again, or ${callLine}. Your details are still in the form.`);
      } finally {
        clearTimeout(timer);
        if (!sent) setBusy(false);
      }
    });
  }
</script>
