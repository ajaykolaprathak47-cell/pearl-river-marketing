---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
---
<Base
  title="Real Estate Advertising & Social Media"
  description="How Pearl River Marketing's Facebook and Instagram advertising and social media content help real estate agents in Picayune and South Mississippi, within Fair Housing and housing-ad rules."
>
  <PageHero
    eyebrow="For real estate agents"
    title="Your listings, seen by more local buyers."
    lede="Our two services, applied to real estate: ads that promote your listings, and posts that keep your name in front of buyers and sellers."
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-2 two">
        <article class="card">
          <ServiceIcon name="advertising" />
          <h2>Listing ads</h2>
          <ul class="check-list">
            <li>"Just listed" and price-change ads</li>
            <li>Open house promotion</li>
            <li>Home-value ads for seller inquiries</li>
          </ul>
          <a class="text-link arrow" href="/contact?service=advertising" data-track="cta_re_ads">Request an advertising quote</a>
        </article>
        <article class="card">
          <ServiceIcon name="social-media" />
          <h2>Agent content</h2>
          <ul class="check-list">
            <li>Just listed, under contract and sold graphics</li>
            <li>Community and market posts</li>
            <li>A steady posting schedule, in your voice</li>
          </ul>
          <a class="text-link arrow" href="/contact?service=social-media" data-track="cta_re_social">Request a social media quote</a>
        </article>
      </div>
      <p class="scope">Same two services, same process. Real estate isn't a separate service.</p>
    </div>
  </section>

  <section class="section section--canvas fh-wrap">
    <div class="container fh">
      <div>
        <span class="eyebrow">Fair Housing</span>
        <h2>Every ad follows Fair Housing and housing-ad rules.</h2>
      </div>
      <ul class="check-list">
        <li>No ad states or implies a preference or limitation based on race, color, religion, sex, disability, familial status or national origin.</li>
        <li>Housing ads run in Meta's required housing category, which limits targeting by age, gender and ZIP code.</li>
        <li>No targeting, exclusions or workarounds aimed at any protected group.</li>
        <li>Listing details come from you, and you or your broker approve every ad and post.</li>
      </ul>
      <p class="small">A summary of how we work, not legal advice.</p>
    </div>
  </section>

  <CtaBand heading="Let's talk about your listings." text="Ad spend is paid directly to Meta and is separate from our fee." track="cta_re_final" />
</Base>

<style>
  .two .card { gap: 1.1rem; }
  .two h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem); }
  .two .text-link { margin-top: auto; padding-top: .5rem; }
  .scope { margin-top: 1.5rem; font-size: .9rem; color: var(--ink-faint); }
  .fh { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 1.5rem clamp(2rem, 6vw, 5rem); align-items: start; }
  .fh > div { display: grid; gap: 1rem; }
  .fh h2 { font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem); }
  .fh .small { grid-column: 2; font-size: .85rem; color: var(--ink-faint); }
  @media (max-width: 800px) { .fh { grid-template-columns: 1fr; } .fh .small { grid-column: auto; } }
</style>
