---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';

const reFaq = [
  {
    q: 'Can you target ads to specific neighborhoods or types of buyers?',
    a: 'Only within the housing ad rules. On Facebook and Instagram, housing ads use a Special Ad Category that removes targeting by age, gender and ZIP code and requires a broader location radius. Google restricts similar targeting for housing ads in the US. We never try to include or exclude people based on race, color, religion, sex, disability, familial status or national origin, directly or through proxies.',
  },
  {
    q: 'How many leads will I get?',
    a: 'We cannot promise a number. Lead volume depends on your market, listings, price points, budget, competition and how quickly your agents respond. We will share what we think is realistic after reviewing your market, and report exactly what comes in.',
  },
  {
    q: 'Do the leads go to one agent or the whole office?',
    a: 'Your choice. We can route inquiries to a shared inbox, a specific agent, or your CRM, depending on the tools you already use.',
  },
  {
    q: 'Who approves the ads?',
    a: 'Your broker or designated person approves every ad and landing page before it runs. Ads include the brokerage information your license rules require, and listing details come from you, not guesswork.',
  },
];
---
<Base
  title="Real Estate Marketing for Brokerages & Agents in Mississippi"
  description="Google Search and Facebook and Instagram ads, listing campaigns, landing pages and lead tracking for real estate brokerages and agents in Picayune and South Mississippi. Run within Fair Housing and platform housing-ad rules."
>
  <PageHero
    eyebrow="Real estate marketing"
    title="Ads that bring buyer and seller inquiries to your brokerage."
    lede="We run Google Search and Meta advertising for brokerages and agents in Picayune, Pearl River County and South Mississippi, with landing pages, lead capture and tracking so you can see what each campaign produced."
    track="cta_re_hero"
  />

  <section class="section">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Two platforms, two jobs</span>
        <h2>Search catches demand. Social creates it.</h2>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <h3>Google Search</h3>
          <p class="muted">Reaches people actively searching, such as "homes for sale in Picayune" or "what is my house worth". Good for buyer inquiries, home valuation requests and protecting your brokerage name from competitor ads.</p>
        </div>
        <div class="card">
          <h3>Facebook & Instagram</h3>
          <p class="muted">Reaches people in the area before they start searching. Good for new listings, open houses, price changes and home valuation offers, using instant lead forms or a landing page.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we set up</span>
        <h2>The pieces of a real estate campaign</h2>
      </div>
      <div class="grid grid-2 pieces">
        <div>
          <h3>Listing-specific campaigns</h3>
          <p class="muted">Short campaigns for individual listings, open houses or price changes, using accurate details and photos you approve. Useful for sellers who want to see their home actively promoted.</p>
        </div>
        <div>
          <h3>Landing pages</h3>
          <p class="muted">Focused pages for a listing, a home valuation offer or a buyer consultation, each with one clear action and your brokerage details.</p>
        </div>
        <div>
          <h3>Lead capture and routing</h3>
          <p class="muted">Forms and call tracking that deliver each inquiry to the right person quickly, whether that is an agent, a shared inbox or your CRM.</p>
        </div>
        <div>
          <h3>Tracking and reporting</h3>
          <p class="muted">A monthly report showing spend, inquiries by campaign and source, cost per inquiry, and your notes on which leads turned into appointments.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container fh">
      <div class="section-head">
        <span class="eyebrow">Fair Housing</span>
        <h2>Every campaign follows Fair Housing and platform housing-ad rules.</h2>
        <p class="lede">Property advertising has legal requirements that general business advertising does not. We build them into how we work from the start.</p>
      </div>
      <ul class="check-list rules">
        <li>Ads comply with the federal Fair Housing Act and applicable state and local rules. They never state or imply a preference, limitation or exclusion based on race, color, religion, sex, disability, familial status or national origin.</li>
        <li>Facebook and Instagram housing ads run in Meta's required housing Special Ad Category, which limits targeting options such as age, gender and ZIP code.</li>
        <li>Google housing ads follow Google's personalized advertising policies for housing, which restrict similar targeting.</li>
        <li>We do not use targeting, exclusions or audience workarounds to reach or avoid any protected group.</li>
        <li>Property details, prices and claims come from you and are checked before ads run. No misleading claims.</li>
        <li>Your broker approves each ad, and ads include the brokerage information your license rules require.</li>
      </ul>
      <p class="muted small">This is a summary of how we work, not legal advice. Platform policies change; we follow the current version of each platform's housing ad rules.</p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container faq-grid">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Real estate questions</h2>
      </div>
      <Faq items={reFaq} id="re-faq" />
    </div>
  </section>

  <CtaBand heading="Talk through your brokerage's marketing." text="Tell us about your market, listings and team. We will recommend a realistic starting point and explain what it would take to run it well." track="cta_re_final" />
</Base>

<style>
  .two-col { display: grid; gap: 0; }
  .pieces { gap: 2.5rem 3rem; }
  .pieces > div { display: grid; gap: .6rem; padding-top: 1.25rem; border-top: 2px solid var(--navy-800); align-content: start; }
  .pieces h3 { font-size: 1.35rem; }
  .fh { display: grid; gap: 1.5rem; }
  .rules { max-width: 48rem; gap: 1rem; }
  .small { font-size: .9rem; max-width: 48rem; }
  .faq-grid { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
